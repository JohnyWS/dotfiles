[user]
	email = {{ .email }}
	name = {{ .name }}
	signingkey = {{ .gitconfig.signingKey }}
[init]
	defaultBranch = trunk
[push]
	default = current
[pull]
	rebase = true
[rebase]
	autoStash = true
[alias]
	glog = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%ar) %C(bold blue)<%an>%Creset' --abbrev-commit --max-count=20
	slog = log --pretty=format:'%C(yellow)%h %C(red)%ad %C(cyan)%an%C(green)%d %C(reset)%s' --date=human --decorate --max-count=20
[advice]
	detachedHead = false
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
{{- if .privateRepoRoot }}
# Context-based identity switch: repos under privateRepoRoot use the private
# identity overlay (a chezmoi-managed file rendered from privateEmail).
# Trigger path is machine-specific (kept local, not committed). Intent: #identity-switching
[includeIf "gitdir/i:{{ .privateRepoRoot }}"]
	path = ~/.config/git/private.gitconfig
{{- end }}