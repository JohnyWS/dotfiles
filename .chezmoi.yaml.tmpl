data:
  name: "Johny Woller Skovdal"

  email: '{{ promptStringOnce . "email" "Primary email address (used for git, tooling, etc.)" }}'

  gitconfig:
    signingKey: '{{ promptStringOnce . "signingKey" "Public signing key to use (SSH public key for git signing)" }}'

    # Windows-native commit signing program (1Password op-ssh-sign). Prompted per
    # machine; used only by the Windows fragment. WSL signs via the agent socket
    # (see dot_profile.tmpl) and ignores this. Intent: #commit-signing
    windowsSshSignProgram: '{{ promptStringOnce . "windowsSshSignProgram" "Windows op-ssh-sign.exe path for git signing (e.g. the WindowsApps shim); leave empty on POSIX-only machines" }}'

  # Context-based identity switching. privateRepoRoot is a lower-case directory
  # prefix (WITH trailing slash) whose repos use the private identity; empty means
  # no split and the default identity applies everywhere. Machine-specific, kept
  # local at render time, never committed. Intent: #identity-switching
  privateRepoRoot: '{{ promptStringOnce . "privateRepoRoot" "Lower-case repo dir prefix WITH trailing slash that should use the private identity (e.g. c:/git/private/); empty for none" }}'
{{- if .privateRepoRoot }}
  privateEmail: '{{ promptStringOnce . "privateEmail" "Email for the private identity used under privateRepoRoot" }}'
{{- end }}
